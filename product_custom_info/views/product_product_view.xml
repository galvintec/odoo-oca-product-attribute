<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group_custom_info_template']"
                position="attributes"
            >
                <attribute name="invisible">true</attribute>
            </xpath>
            <xpath expr="//group[@name='group_custom_info_template']" position="after">
                <group string="Product template info">
                    <p>This info is managed on<button
                            name="open_product_template"
                            type="object"
                            string="the product template"
                            class="oe_link"
                        /></p>
                    <!-- <field
                        name="product_tmpl_custom_info_ids"
                        colspan="4"
                        nolabel="1"
                        mode="custom_info"
                    /> -->
                    <field name="product_tmpl_custom_info_ids">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="field_type" invisible="true"/>
                            <field name="category_id" readonly="true"/>
                            <field name="property_id" readonly="true"/>
                            <field name="value" attrs="{'readonly': [('field_type','=','id')]}"/>
                            <field name="value_id" attrs="{'readonly': [('field_type','!=','id')]}"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
